# The public-API baselines are byte-compared, so their line endings are
# load-bearing.
#
# `public-api` renders the surface with LF endings, and `snapshot-testing`
# compares the file bytes verbatim -- no normalization anywhere in the chain
# (`std::fs::read_to_string` -> `similar_asserts::assert_eq!`). Without this
# rule, a Windows checkout under `core.autocrlf=true` writes CRLF into the
# working tree and `tests/public_api.rs` fails on every line, for a reason that
# has nothing to do with the public API it guards. Linux CI never sees it.
#
# `text eol=lf` rather than `-text` on purpose: it pins both directions, so an
# editor that saves CRLF still produces an LF blob on `git add` instead of
# turning CI red.
#
# This is scoped, not repo-wide. Any future snapshot or golden file that is
# byte-compared needs its own line here.
tests/public-api-*.txt text eol=lf

# The public corpus manifest pins the normalization script's exact bytes.
crates/audio-automix/benches/support/automix_accuracy/prepare_public_corpus.py text eol=lf
crates/audio-automix/benches/support/automix_accuracy/public_corpus.sha256 text eol=lf
crates/audio-automix/benches/support/automix_accuracy/prepare_development_corpus.py text eol=lf
crates/audio-automix/benches/support/automix_accuracy/gtzan_mini_sources.json text eol=lf
crates/audio-automix/benches/support/automix_accuracy/provision_corpus.py text eol=lf

# Retained measurement evidence is hashed as captured. Its tools emit both LF
# and CRLF, so preserve the original JSON bytes rather than normalize them.
# Keep ordinary whitespace checks, treating a terminal CR as part of CRLF.
# The neural research reports also pin their runner and declaration bytes.
crates/audio-automix/benches/support/automix_accuracy/prepare_edm_development_corpus.py text eol=lf
crates/audio-automix/benches/support/automix_accuracy/test_prepare_edm_development_corpus.py text eol=lf

crates/audio-automix/tests/public-api-*.txt text eol=lf
crates/audio-automix/tests/automix-contract.json text eol=lf
